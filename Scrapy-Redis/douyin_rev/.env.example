# douyin_rev 环境变量模板，复制成 .env 后按需修改。

# ---------- 签名服务（unidbg，必须先在 douyin 目录启动） ----------
DY_SIGN_SERVICE=http://127.0.0.1:8099
DY_SIGN_TIMEOUT=120

# ---------- Redis / DB ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# 生产用 MySQL；不填则落 SQLite（douyin_rev.db）
# DY_DB_URL=mysql+pymysql://root:123456@127.0.0.1:3306/douyin?charset=utf8mb4

# ---------- 抓取节奏 ----------
# 并发：签名服务 6 实例，并发 8 足够
DY_CONCURRENT_REQUESTS=8
DY_DELAY=0.2
DY_TIMEOUT=30

# 单用户最多翻多少页作品（20 条/页）
DY_VIDEO_PAGES=50
# 单视频最多翻多少页评论（20 条/页）；抖音深度上限约 335 页
DY_COMMENT_PAGES=5

# ---------- 任务状态机 ----------
DY_LOCK_TTL=600
DY_STALE_RUNNING_SEC=900
DY_DISPATCH_GUARD_TTL=600

# ---------- 任务拆分 ----------
# 1=评论拆成独立 video_task（user spider 只抓详情+作品）；0=内联评论
DY_SPLIT_COMMENTS=1

# ---------- 设备 ----------
# 设备目标数（= pool-size；不足则启动/spider 初始化时自动注册补齐）
DY_DEVICE_TARGET=12
# 启动时最多探测几台设备（其余乐观放行，避免慢设备拖死启动）
DY_PROBE_MAX=6
# 探测结果缓存有效期（秒）
DY_PROBE_TTL=900

# ---------- 自愈阈值 ----------
# user_task：running 超时翻回 pending（必须 > DY_LOCK_TTL）
DY_LOCK_TTL=600
DY_STALE_RUNNING_SEC=900
# video_task：同上
DY_VIDEO_LOCK_TTL=900
DY_VIDEO_STALE_RUNNING_SEC=1200
